# Anthropic API key used to generate the daily insight (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: override the model used for daily insights (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Garmin Connect credentials, used for the unofficial Garmin sync
# (this is your normal Garmin Connect login, not an API key — Garmin has no
# personal-use official API, see README for the caveats)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: where the SQLite database file is stored (defaults to ./data/health.db)
# DATABASE_PATH=./data/health.db
